DEBUG=true
LOG_LEVEL=INFO

# База данных (локальный Docker)
DATABASE_URL=postgresql+asyncpg://kotodama:kotodama_secret_k8s_key_2026@localhost:5432/kotodama
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis и MinIO (локальный Docker)
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=kotodama_admin
MINIO_SECRET_KEY=kotodama_minio_secret_k8s_key_2026
MINIO_BUCKET_ASSETS=kotodama-assets
MINIO_BUCKET_BUILDS=kotodama-builds
MINIO_SECURE=false

# LLM (ИСПОЛЬЗУЕМ ТВОЙ СУЩЕСТВУЮЩИЙ OLLAMA)
OLLAMA_BASE_URL=http://localhost:11434
LLM_CODE_MODEL=qwen2.5-coder:32b
LLM_DESIGN_MODEL=qwen2.5:32b
LLM_EMBEDDING_MODEL=nomic-embed-text

# Прочее
GPU_VENDOR=AMD
GPU_BACKEND=rocm
WORKSPACE_ROOT=/home/orlovatty/Projects/kotodama/workspace
