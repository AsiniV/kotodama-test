# Kotodama Environment Configuration
# Copy this file to .env and fill in your values

# Application Settings
APP_NAME=Kotodama
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# Database (PostgreSQL with PGVector)
DATABASE_URL=postgresql+asyncpg://kotodama:kotodama_secret@localhost:5432/kotodama

# Redis
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=kotodama_admin
MINIO_SECRET_KEY=kotodama_minio_secret
MINIO_BUCKET_ASSETS=kotodama-assets
MINIO_BUCKET_BUILDS=kotodama-builds
MINIO_SECURE=false

# Ollama (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
LLM_CODE_MODEL=qwen2.5-coder:32b
LLM_DESIGN_MODEL=qwen2.5:32b
LLM_EMBEDDING_MODEL=nomic-embed-text

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Generation Settings
MAX_GENERATION_ATTEMPTS=2
PLAYTEST_TIMEOUT_SECONDS=30
MAX_WORKSPACE_SIZE_MB=500

# External Services (optional, for cloud fallback)
FAL_API_KEY=
REPLICATE_API_KEY=
