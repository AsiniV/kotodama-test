# =============================================================================
# KOTODAMA - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values
# Technical Specification v2.0 Final
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL 16 + PGVector)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://kotodama:kotodama_secret@localhost:5432/kotodama
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# -----------------------------------------------------------------------------
# REDIS (Caching & Task Queue)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_DB=0

# -----------------------------------------------------------------------------
# MINIO (S3-Compatible Object Storage)
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=kotodama_admin
MINIO_SECRET_KEY=kotodama_minio_secret_k8s_key_2026
MINIO_BUCKET_ASSETS=kotodama-assets
MINIO_BUCKET_BUILDS=kotodama-builds
MINIO_SECURE=false

# -----------------------------------------------------------------------------
# OLLAMA / LLM (Local AI Inference)
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
LLM_CODE_MODEL=qwen2.5-coder:32b
LLM_DESIGN_MODEL=qwen2.5:32b
LLM_EMBEDDING_MODEL=nomic-embed-text
LLM_TEMPERATURE_CODE=0.15
LLM_TEMPERATURE_DESIGN=0.6
LLM_MAX_TOKENS=4096

# -----------------------------------------------------------------------------
# STABLE DIFFUSION (Image Generation)
# -----------------------------------------------------------------------------
STABLE_DIFFUSION_URL=http://localhost:7860
STABLE_DIFFUSION_CHECKPOINT=sd_xl_base_1.0.safetensors
STABLE_DIFFUSION_STEPS=30
STABLE_DIFFUSION_WIDTH=1024
STABLE_DIFFUSION_HEIGHT=1024

# Cloud fallback (optional)
FAL_API_KEY=
REPLICATE_API_KEY=
FLUX_API_KEY=

# -----------------------------------------------------------------------------
# STRIPE / BILLING (Payment Processing)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRICE_ID_STARTER=price_
STRIPE_PRICE_ID_PRO=price_
STRIPE_PRICE_ID_STUDIO=price_

# Credit pricing
CREDITS_PER_USD=10
CREDIT_COST_SIMPLE_GAME=10
CREDIT_COST_COMPLEX_GAME=50
CREDIT_COST_EPIC_QUESTS_MULTIPLIER=1.5
CREDIT_COST_FULL_RPG_DIALOGUES_MULTIPLIER=1.5

# -----------------------------------------------------------------------------
# GODOT (Game Engine Configuration)
# -----------------------------------------------------------------------------
GODOT_VERSION=4.3
GODOT_HEADLESS_PATH=/usr/local/bin/godot
GODOT_EXPORT_PRESET_ANDROID=Android
GODOT_EXPORT_PRESET_IOS=iOS
GODOT_EXPORT_PRESET_WEB=Web
GODOT_PLAYTEST_TIMEOUT_SECONDS=30
GODOT_MAX_FRAMES=900

# -----------------------------------------------------------------------------
# SECURITY (Authentication & Authorization)
# -----------------------------------------------------------------------------
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# CORS settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=100

# -----------------------------------------------------------------------------
# GENERATION SETTINGS (AI Pipeline Configuration)
# -----------------------------------------------------------------------------
MAX_GENERATION_ATTEMPTS=2
PLAYTEST_TIMEOUT_SECONDS=30
MAX_WORKSPACE_SIZE_MB=500
MAX_MODULES_PER_GAME=10
ENABLE_INCREMENTAL_UPDATES=true
ENABLE_ROLLBACK=true

# Agent configuration
AGENT_TIMEOUT_SECONDS=120
AGENT_RETRY_COUNT=3

# -----------------------------------------------------------------------------
# LOGGING & MONITORING
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true

# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------
APP_NAME=Kotodama
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# NGINX / REVERSE PROXY (Production only)
# -----------------------------------------------------------------------------
NGINX_PORT=80
NGINX_SSL_PORT=443
NGINX_SSL_CERTIFICATE=/etc/ssl/certs/kotodama.crt
NGINX_SSL_CERTIFICATE_KEY=/etc/ssl/private/kotodama.key

# -----------------------------------------------------------------------------
# BACKUP & MAINTENANCE
# -----------------------------------------------------------------------------
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=kotodama-backups
