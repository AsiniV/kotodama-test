# =============================================================================
# KOTODAMA - Локальный .env для режима "LLM нативно в WSL2" (ЭТАП 1.4)
# =============================================================================
# Использование:
#   Windows/WSL2: скопируйте этот файл в .env в корне проекта:
#       cp .env.kotodama.local .env
#   Файл .env уже содержит эти значения — данный файл служит эталонной копией
#   на случай перезапуска/пересоздания окружения (.env игнорируется git-ом).
#
# ВАЖНО:
#   * DATABASE_URL / REDIS_URL / MINIO_ENDPOINT указывают на сервисы docker-сети
#     (postgres, redis, minio), а НЕ на localhost — внутри контейнера localhost
#     это сам контейнер.
#   * OLLAMA_BASE_URL=http://host.docker.internal:11434 — контейнеры стучатся к
#     Ollama, запущенному нативно в WSL2 (ROCm, AMD iGPU gfx1151).
#     Для запуска backend НАПРЯМУЮ из-под WSL2 (вне Docker) замените
#     host.docker.internal на localhost, а postgres/redis/minio — на localhost
#     (их порты проброшены: 5432, 6379, 9000).
# =============================================================================

DEBUG=true
LOG_LEVEL=INFO

# База данных (указываем на сервис docker-сети, а не localhost)
DATABASE_URL=postgresql+asyncpg://kotodama:kotodama_secret_k8s_key_2026@postgres:5432/kotodama
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis & MinIO
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=kotodama_admin
MINIO_SECRET_KEY=kotodama_minio_secret_k8s_key_2026

# LLM (host.docker.internal указывает из контейнера Docker на твой хост WSL2)
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_CODE_MODEL=qwen2.5-coder:32b
LLM_DESIGN_MODEL=qwen2.5:32b
LLM_EMBEDDING_MODEL=nomic-embed-text

# GPU
GPU_VENDOR=AMD
GPU_BACKEND=rocm
